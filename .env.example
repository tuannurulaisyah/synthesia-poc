# Copy this file to .env in the project root and fill in real values.

# LiveKit Cloud project (https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Same LiveKit URL, exposed to the Vite dev frontend
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# Synthesia (https://docs.synthesia.io)
SYNTHESIA_API_KEY=
AVATAR_ID=

# Confluence page used as the agent's knowledge base
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net
CONFLUENCE_PAGE_ID=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
